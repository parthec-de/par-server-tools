#!/usr/bin/env bash

set -euo pipefail

install_pkg() {
  sudo apt-get update && sudo apt-get install -y "$1"
}

install_gum() {
  sudo mkdir -p /etc/apt/keyrings
  test -f /etc/apt/keyrings/charm.gpg \
    || curl -fsSL https://repo.charm.sh/apt/gpg.key \
      | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
  test -f /etc/apt/sources.list.d/charm.list \
    || echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
      | sudo tee /etc/apt/sources.list.d/charm.list
  install_pkg "gum"
}

_restic_version_checked=false

install_restic() {
  if ! command -v restic > /dev/null; then
    info "Installing restic..."
    install_pkg "restic"
  fi

  if [[ "$_restic_version_checked" == false ]]; then
    _warn_old_restic
    _restic_version_checked=true
  fi
}

# Compression is on by default since 0.16, older releases also prune much slower.
_warn_old_restic() {
  local version major minor
  version="$(restic version 2> /dev/null | awk '{print $2}')"
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"

  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 0
  if ((major == 0 && minor < 16)); then
    warn "restic $version is older than 0.16. Install a newer one for compression by default and a faster prune."
  fi
}

script_name="parbackup"
script_version="1.9.0"
script_invocation="$0 $*"
parbackupfile_name="${PARBACKUPFILE:-Parbackupfile}"
config_dir="${HOME}/.config/par"
config_file="${config_dir}/parbackup.conf"
working_dir="/tmp/parbackup"
run_log_dir="${working_dir}/runs"

# The staging tree of the restic backend keeps a fixed path per BACKUP_NAME so
# restic finds the parent snapshot and skips unchanged files.
restic_staging_root="${PARBACKUP_STAGING_ROOT:-/var/cache/parbackup/staging}"

# set by require_parbackupfile
BACKUP_RETENTION_DAYS=""
BACKUP_RETENTION_WEEKLY=""
BACKUP_RETENTION_MONTHLY=""
BACKUP_BACKEND_OVERRIDE=""

# set by cleanup --backend
BACKEND_OVERRIDE=""

ensure_working_dir() {
  mkdir -p "$working_dir"
}

BACKUP_LOG_FILE=""
RUN_LOG_FILE=""

_log_to_file() {
  local level="$1"
  local msg="$2"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  if [[ -n "$BACKUP_LOG_FILE" ]]; then
    echo "$ts [$level] $msg" >> "$BACKUP_LOG_FILE"
  fi
  if [[ -n "$RUN_LOG_FILE" ]]; then
    echo "$ts [$level] $msg" >> "$RUN_LOG_FILE"
  fi
}

# Append lines from stdin to BACKUP_LOG_FILE and RUN_LOG_FILE with a prefix, while also
# passing them through to stderr.
# Usage: some_command 2>&1 | _tee_to_log "prefix"
#   or:  some_command 2> >(_tee_to_log "pg_dump")
_tee_to_log() {
  local prefix="$1"
  if [[ -n "$BACKUP_LOG_FILE" || -n "$RUN_LOG_FILE" ]]; then
    while IFS= read -r line; do
      echo "$line" >&2
      local ts
      ts="$(date '+%Y-%m-%d %H:%M:%S')"
      if [[ -n "$BACKUP_LOG_FILE" ]]; then
        echo "$ts [$prefix] $line" >> "$BACKUP_LOG_FILE"
      fi
      if [[ -n "$RUN_LOG_FILE" ]]; then
        echo "$ts [$prefix] $line" >> "$RUN_LOG_FILE"
      fi
    done
  else
    cat >&2
  fi
}

info() {
  gum log -l info -- "$1"
  _log_to_file "INFO" "$1"
}

warn() {
  gum log -l warn -- "$1"
  _log_to_file "WARN" "$1"
}

error() {
  gum log -l error -- "$1"
  _log_to_file "ERROR" "$1"
}

fail() {
  error "$1"
  exit 1
}

fail_parse_options() {
  fail "Failed to parse options"
}

fail_help() {
  error "$1"
  echo ""
  print_help
  exit 1
}

print_help() {
  cat << EOF
$script_name v$script_version -- backup manager for Docker deployments

Usage: parbackup <command> [options]

Commands:
  create      Create a backup and upload it to the configured backend
  download    Download a backup from the backend
  restore     Restore a backup from the backend, an archive or a directory
  ls          List available backups
  cleanup     Forget backups beyond the retention period
  restic      Manage the restic repositories (init, prune, check)
  cron        Manage cron schedule for automated backups
  config      Show or set configuration
  help        Show this help message

Options:
  -h, --help  Show help message

Command-specific options:
  create:
    --local            Build the staging tree only, no upload (no config needed)
    --keep-local       Keep the staging tree after a successful upload
    --no-prune         restic: forget snapshots without pruning, frees space later
    -f, --file <path>  Path to Parbackupfile (default: ./Parbackupfile)

  ls:
    [prefix]           Optional prefix to filter backups (e.g. project name)
    --tree             Display results as a directory tree (builtin only)
    --timestamps       List backups as <epoch>\t<key> per line

  cleanup:
    --dry-run          Show which backups would be deleted, without deleting
    --backend <name>   builtin or restic, overrides the configuration
    -f, --file <path>  Only clean up backups of this Parbackupfile, using its RETENTION_DAYS

  restic init:
    -f, --file <path>  Parbackupfile whose repository to create

  restic prune:
    --dry-run          Show what prune would free, without rewriting packs
    -f, --file <path>  Only prune the repository of this Parbackupfile

  restic check:
    --read-data-subset <value>  Read a share of the packs, e.g. 1/7 or 5%
    -f, --file <path>  Only check the repository of this Parbackupfile

  cron:
    -f, --file <path>  Path to Parbackupfile (required for add/remove)
    show               List all parbackup cron entries
    remove             Remove cron entry for the given Parbackupfile

  download:
    <backup_ref>       Key of the backup to download
    --pick             Interactively choose a backup to download
    -f, --force        Overwrite existing local data without prompting

  restore:
    <backup_ref>       Key of the backup (default), or local path with --local
    --pick             Interactively choose a backup to restore
    --local            Restore from a local .tar.gz or directory instead of the backend
    -f, --force        Skip confirmation prompt

  config:
    set                Interactively configure S3 and the backend
    set s3             Interactively configure S3 only
    set restic         Interactively configure the restic backend

The builtin backend packs one .tar.gz per run and ages the archives out. The
restic backend stores deduplicated, encrypted snapshots and forgets them with
--keep-daily/--keep-weekly/--keep-monthly. BACKUP_BACKEND selects the default,
a Parbackupfile overrides it.

Examples:
  parbackup config set
  parbackup config set restic
  parbackup config
  parbackup create
  parbackup create --local
  parbackup create --no-prune
  parbackup create -f /opt/my-project/Parbackupfile
  parbackup download --pick
  parbackup download my_project/my_project-2026-02-27_14-30-22.tar.gz
  parbackup download my_project/1a2b3c4d
  parbackup restore --pick
  parbackup restore my_project/my_project-2026-02-27_14-30-22.tar.gz
  parbackup restore my_project/1a2b3c4d
  parbackup restore --local /tmp/parbackup/my_project-2026-02-27_14-30-22.tar.gz
  parbackup restore --local --force /tmp/parbackup/my_project-2026-02-27_14-30-22.tar.gz
  parbackup ls
  parbackup ls my_project/
  parbackup cleanup -f /opt/my-project/Parbackupfile
  parbackup cleanup --dry-run --backend builtin
  parbackup restic init -f /opt/my-project/Parbackupfile
  parbackup restic prune -f /opt/my-project/Parbackupfile
  parbackup restic check -f /opt/my-project/Parbackupfile --read-data-subset 1/7
  parbackup cron -f /opt/my-project/Parbackupfile
  parbackup cron show
  parbackup cron remove -f /opt/my-project/Parbackupfile
EOF
}

# Load and validate an Parbackupfile.
# Usage: require_parbackupfile [path]
# If no path is given, looks for ./Parbackupfile in the current directory.
require_parbackupfile() {
  local backupfile="${1:-./$parbackupfile_name}"

  if [[ ! -f "$backupfile" ]]; then
    fail "No $parbackupfile_name found at '$backupfile'"
  fi

  info "Loading $backupfile..."

  # The Parbackupfile may override settings that also live in the config. Keep the
  # config values and expose the file values as BACKUP_*.
  local -A config_values=()
  local var
  for var in RETENTION_DAYS RETENTION_WEEKLY RETENTION_MONTHLY BACKUP_BACKEND; do
    if [[ -v "$var" ]]; then
      config_values["$var"]="${!var}"
    fi
    unset "$var"
  done

  # shellcheck source=/dev/null
  source "$backupfile"

  BACKUP_RETENTION_DAYS="${RETENTION_DAYS:-}"
  BACKUP_RETENTION_WEEKLY="${RETENTION_WEEKLY:-}"
  BACKUP_RETENTION_MONTHLY="${RETENTION_MONTHLY:-}"
  BACKUP_BACKEND_OVERRIDE="${BACKUP_BACKEND:-}"
  unset RETENTION_DAYS RETENTION_WEEKLY RETENTION_MONTHLY BACKUP_BACKEND

  for var in "${!config_values[@]}"; do
    printf -v "$var" '%s' "${config_values[$var]}"
  done

  # Validate required top-level variables
  if [[ -z "${BACKUP_NAME:-}" ]]; then
    fail "BACKUP_NAME is not set in $backupfile"
  fi
  if [[ -z "${SERVICES:-}" ]]; then
    fail "SERVICES is not set in $backupfile"
  fi
}

# Effective backend, the Parbackupfile overrides the configuration.
backend() {
  local selected="${BACKEND_OVERRIDE:-${BACKUP_BACKEND_OVERRIDE:-${BACKUP_BACKEND:-builtin}}}"
  case "$selected" in
    builtin | restic)
      echo "$selected"
      ;;
    *)
      fail "Unknown BACKUP_BACKEND '$selected', expected 'builtin' or 'restic'"
      ;;
  esac
}

effective_retention_days() {
  echo "${BACKUP_RETENTION_DAYS:-${RETENTION_DAYS:-0}}"
}

effective_retention_weekly() {
  echo "${BACKUP_RETENTION_WEEKLY:-${RETENTION_WEEKLY:-}}"
}

effective_retention_monthly() {
  echo "${BACKUP_RETENTION_MONTHLY:-${RETENTION_MONTHLY:-}}"
}

# Calendar retention exists for restic only, the builtin backend ages archives out.
warn_unused_retention() {
  [[ "$(backend)" == builtin ]] || return 0

  [[ -n "$(effective_retention_weekly)" ]] \
    && warn "RETENTION_WEEKLY has no effect with BACKUP_BACKEND=builtin"
  [[ -n "$(effective_retention_monthly)" ]] \
    && warn "RETENTION_MONTHLY has no effect with BACKUP_BACKEND=builtin"
  return 0
}

# Resolve a per-service variable. Usage: get_svc_var <service_name> <var_suffix>
# Example: get_svc_var "app_db" "TYPE" reads the variable APP_DB_TYPE
get_svc_var() {
  local svc_name="$1"
  local var_suffix="$2"
  local var_name="${svc_name^^}_${var_suffix}"
  echo "${!var_name:-}"
}

# Validate that a required per-service variable is set.
require_svc_var() {
  local svc_name="$1"
  local var_suffix="$2"
  local value
  value="$(get_svc_var "$svc_name" "$var_suffix")"
  if [[ -z "$value" ]]; then
    fail "Missing required variable ${svc_name^^}_${var_suffix} for service '$svc_name'"
  fi
  echo "$value"
}

# --- Config ---

load_config() {
  if [[ ! -f "$config_file" ]]; then
    return 1
  fi
  # shellcheck source=/dev/null
  source "$config_file"
}

require_config() {
  if ! load_config; then
    fail "No config found at $config_file. Run 'parbackup config set' to configure S3."
  fi
  local missing=()
  [[ -z "${S3_ENDPOINT:-}" ]] && missing+=("S3_ENDPOINT")
  [[ -z "${S3_BUCKET:-}" ]] && missing+=("S3_BUCKET")
  [[ -z "${S3_ACCESS_KEY:-}" ]] && missing+=("S3_ACCESS_KEY")
  [[ -z "${S3_SECRET_KEY:-}" ]] && missing+=("S3_SECRET_KEY")
  if [[ ${#missing[@]} -gt 0 ]]; then
    fail "Missing config variables in $config_file: ${missing[*]}"
  fi
}

mask_secret() {
  local value="$1"
  if [[ ${#value} -le 4 ]]; then
    echo "****"
  else
    echo "${value:0:4}****"
  fi
}

install_s3cmd() {
  if command -v s3cmd > /dev/null; then
    return 0
  fi
  info "Installing s3cmd..."
  install_pkg "s3cmd"
}

install_rsync() {
  if command -v rsync > /dev/null; then
    return 0
  fi
  info "Installing rsync..."
  install_pkg "rsync"
}

s3_cmd() {
  install_s3cmd

  local host
  host="$(echo "$S3_ENDPOINT" | sed 's|https\?://||')"

  local -a extra_args=()
  if [[ "$S3_ENDPOINT" == http://* ]]; then
    # Explicitly add `--no-ssl`, if we're dealing with an HTTP endpoint.
    extra_args+=(--no-ssl)
  fi
  if [[ -n "${S3_REGION:-}" ]]; then
    extra_args+=(--region="$S3_REGION")
  fi

  s3cmd \
    --access_key="$S3_ACCESS_KEY" \
    --secret_key="$S3_SECRET_KEY" \
    --host="$host" \
    --host-bucket="$host/%(bucket)" \
    "${extra_args[@]}" \
    "$@"
}

s3_upload() {
  local local_path="$1"
  local s3_key="$2"

  s3_cmd put "$local_path" "s3://${S3_BUCKET}/${s3_key}" 2> >(_tee_to_log "s3 upload")
}

s3_download() {
  local s3_key="$1"
  local local_path="$2"

  s3_cmd get "s3://${S3_BUCKET}/${s3_key}" "$local_path" 2> >(_tee_to_log "s3 download")
}

s3_list() {
  local prefix="${1:-}"

  s3_cmd ls "s3://${S3_BUCKET}/${prefix}" 2> >(_tee_to_log "s3 ls")
}

# --- restic backend ---

restic_secret_file() {
  echo "${RESTIC_SECRET_FILE:-${config_dir}/restic-secret}"
}

restic_cache_dir() {
  echo "${RESTIC_CACHE_DIR:-/var/cache/parbackup/restic}"
}

require_restic_config() {
  local secret
  secret="$(restic_secret_file)"

  # A password from the environment wins, it keeps the tests free of secret files.
  if [[ -n "${RESTIC_PASSWORD:-}" ]]; then
    return 0
  fi

  if [[ ! -f "$secret" ]]; then
    fail "Missing restic secret file: $secret. Create it with 'parbackup config set restic'."
  fi

  local mode
  mode="$(stat -c '%a' "$secret")"
  if [[ "$mode" != "600" && "$mode" != "400" ]]; then
    fail "Secret file $secret has mode $mode, expected 600"
  fi
}

# Prefix in the bucket that holds one repository per Parbackupfile. An empty
# prefix puts the repositories directly below the bucket.
restic_repo_prefix() {
  local prefix="${RESTIC_REPO_PREFIX:-restic}"
  prefix="${prefix#/}"
  prefix="${prefix%/}"
  echo "$prefix"
}

# Each Parbackupfile gets its own repository, so retention and prune stay scoped
# to one deployment.
restic_repository_for() {
  local backup_name="$1"
  local prefix
  prefix="$(restic_repo_prefix)"

  if [[ -n "$prefix" ]]; then
    echo "s3:${S3_ENDPOINT}/${S3_BUCKET}/${prefix}/${backup_name}"
  else
    echo "s3:${S3_ENDPOINT}/${S3_BUCKET}/${backup_name}"
  fi
}

restic_cmd() {
  local repository="$1"
  shift

  install_restic

  # The repository always lives in the configured S3 bucket, so it always takes
  # the credentials from the parbackup config.
  local -a env_args=(
    "RESTIC_REPOSITORY=${repository}"
    "RESTIC_CACHE_DIR=$(restic_cache_dir)"
    "AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY:-}"
    "AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY:-}"
  )
  [[ -n "${S3_REGION:-}" ]] && env_args+=("AWS_DEFAULT_REGION=${S3_REGION}")

  if [[ -n "${RESTIC_PASSWORD:-}" ]]; then
    env_args+=("RESTIC_PASSWORD=${RESTIC_PASSWORD}")
  else
    env_args+=("RESTIC_PASSWORD_FILE=$(restic_secret_file)")
  fi

  env "${env_args[@]}" restic "$@"
}

restic_repo_exists() {
  restic_cmd "$1" cat config > /dev/null 2>&1
}

restic_init_repository() {
  local repository="$1"

  if restic_repo_exists "$repository"; then
    return 0
  fi

  info "Initializing restic repository $repository"
  restic_cmd "$repository" init 2>&1 | _tee_to_log "restic init"
}

# Print the repository names below the prefix.
restic_repo_names() {
  local prefix s3_path
  prefix="$(restic_repo_prefix)"
  s3_path="s3://${S3_BUCKET}${prefix:+/$prefix}"

  { s3_cmd ls "${s3_path}/" 2> >(_tee_to_log "s3 ls") || true; } \
    | while IFS= read -r line; do
        local entry="${line##* }"
        entry="${entry#"${s3_path}/"}"
        entry="${entry%/}"
        [[ -n "$entry" && "$entry" != */* ]] && echo "$entry"
    done
}

# Print "<epoch>\t<short_id>" per snapshot of a repository.
restic_snapshot_rows() {
  local repository="$1"

  { restic_cmd "$repository" snapshots 2> >(_tee_to_log "restic snapshots") || true; } \
    | awk '$1 ~ /^[0-9a-f]+$/ && $2 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ { print $2 " " $3 "\t" $1 }' \
    | while IFS=$'\t' read -r snapshot_time snapshot_id; do
        local epoch
        epoch="$(date -d "$snapshot_time" +%s 2> /dev/null || true)"
        [[ -n "$epoch" ]] && printf '%s\t%s\n' "$epoch" "$snapshot_id"
    done
}

# Print "<epoch>\t<backup_name>/<short_id>" for every snapshot below the prefix.
restic_all_snapshot_rows() {
  local name
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    restic_snapshot_rows "$(restic_repository_for "$name")" \
      | awk -F'\t' -v name="$name" '{ print $1 "\t" name "/" $2 }'
  done < <(restic_repo_names | sort)
}

# Turn "<epoch>\t<reference>" from stdin into "<YYYY-mm-dd HH:MM>\t<reference>".
format_snapshot_refs() {
  while IFS=$'\t' read -r epoch reference; do
    [[ -z "$epoch" ]] && continue
    printf '%s\t%s\n' "$(date -d "@${epoch}" '+%Y-%m-%d %H:%M')" "$reference"
  done
}

# Split "<backup_name>/<snapshot_id>" into RESTORE_REPO_NAME and RESTORE_SNAPSHOT.
parse_snapshot_ref() {
  local ref="$1"

  if [[ "$ref" != */* ]]; then
    fail "Expected <backup_name>/<snapshot_id>, got '$ref'"
  fi

  RESTORE_REPO_NAME="${ref%%/*}"
  RESTORE_SNAPSHOT="${ref#*/}"

  if [[ -z "$RESTORE_REPO_NAME" || -z "$RESTORE_SNAPSHOT" ]]; then
    fail "Expected <backup_name>/<snapshot_id>, got '$ref'"
  fi
}

# Restore a snapshot below a new target directory. Prints the restored staging dir.
restic_restore_snapshot() {
  local repository="$1"
  local snapshot="$2"
  local target="$3"
  local backup_name="$4"

  info "Restoring snapshot $snapshot from $repository"

  restic_cmd "$repository" restore "$snapshot" --target "$target" \
    2>&1 | _tee_to_log "restic restore"

  echo "${target}${restic_staging_root}/${backup_name}"
}

# Resolve the host directory behind a container path.
# Prints the path and returns 0, or prints nothing and returns 1.
resolve_host_path() {
  local svc_name="$1"
  local container path
  container="$(require_svc_var "$svc_name" "CONTAINER")"
  path="$(require_svc_var "$svc_name" "PATH")"
  path="${path%/}"

  local mounts
  if ! mounts="$(docker inspect --format '{{range .Mounts}}{{.Destination}}|{{.Source}}{{"\n"}}{{end}}' "$container" 2> /dev/null)"; then
    return 1
  fi

  local destination source match="" match_length=0 best_source=""
  while IFS='|' read -r destination source; do
    [[ -z "$destination" || -z "$source" ]] && continue
    destination="${destination%/}"

    # The container path may sit below the mount point, e.g. uploads in /app.
    if [[ "$path" == "$destination" || "$path" == "$destination"/* ]]; then
      if ((${#destination} > match_length)); then
        match="$destination"
        match_length="${#destination}"
        best_source="$source"
      fi
    fi
  done <<< "$mounts"

  [[ -z "$match" ]] && return 1

  local host_path="${best_source%/}${path#"$match"}"
  [[ -d "$host_path" ]] || return 1

  echo "$host_path"
}

record_manifest_entry() {
  local staging="$1"
  local svc_name="$2"
  local svc_type="$3"
  local host_path="$4"

  printf '%s\t%s\t%s\n' "$svc_name" "$svc_type" "$host_path" >> "${staging}/parbackup.manifest"
}

manifest_host_path() {
  local backup_dir="$1"
  local svc_name="$2"
  local manifest="${backup_dir}/parbackup.manifest"

  [[ -f "$manifest" ]] || return 1
  awk -F'\t' -v svc="$svc_name" '$1 == svc { print $3; exit }' "$manifest"
}

# --- Backup/Restore helpers ---

backup_postgres() {
  local svc_name="$1"
  local target_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${target_dir}/dump.sql"

  info "  Dumping Postgres database '$db_name' from container '$container'..."

  docker exec -e PGPASSWORD="$db_password" "$container" \
    pg_dump -U "$db_user" "$db_name" > "$dump_file" \
    2> >(_tee_to_log "pg_dump") \
    || fail "pg_dump failed in container '$container' (is pg_dump installed?)"

  info "  Postgres dump saved to $dump_file"
}

backup_mongo() {
  local svc_name="$1"
  local target_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${target_dir}/dump.archive"

  info "  Dumping MongoDB database '$db_name' from container '$container'..."

  docker exec "$container" \
    mongodump \
      --username "$db_user" \
      --password "$db_password" \
      --authenticationDatabase admin \
      --db "$db_name" \
      --archive > "$dump_file" \
    2> >(_tee_to_log "mongodump") \
    || fail "mongodump failed in container '$container' (is mongodump installed?)"

  info "  MongoDB dump saved to $dump_file"
}

backup_mysql() {
  local svc_name="$1"
  local target_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${target_dir}/dump.sql"

  info "  Dumping MySQL database '$db_name' from container '$container'..."

  # --single-transaction: consistent online dump of InnoDB tables without locking.
  # --no-tablespaces: avoids requiring the PROCESS privilege.
  # MYSQL_PWD keeps the password off the command line (like PGPASSWORD for Postgres).
  docker exec -e MYSQL_PWD="$db_password" "$container" \
    mysqldump --single-transaction --no-tablespaces -u "$db_user" "$db_name" > "$dump_file" \
    2> >(_tee_to_log "mysqldump") \
    || fail "mysqldump failed in container '$container' (is mysqldump installed?)"

  info "  MySQL dump saved to $dump_file"
}

restore_postgres() {
  local svc_name="$1"
  local source_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${source_dir}/dump.sql"

  if [[ ! -f "$dump_file" ]]; then
    fail "Postgres dump file not found: $dump_file"
  fi

  info "  Restoring Postgres database '$db_name' in container '$container'..."

  # Drop and recreate the database to ensure a clean restore.
  # Connect to template1 to avoid "cannot drop the currently open database" error.
  # Terminate active connections to the target database first.
  docker exec -e PGPASSWORD="$db_password" "$container" \
    psql -U "$db_user" -d template1 \
      -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$db_name' AND pid <> pg_backend_pid();" \
      -c "DROP DATABASE IF EXISTS \"$db_name\";" \
      -c "CREATE DATABASE \"$db_name\";" \
    || fail "Failed to drop/recreate database '$db_name' in container '$container'"

  docker exec -i -e PGPASSWORD="$db_password" "$container" \
    psql -U "$db_user" -d "$db_name" < "$dump_file" \
    || fail "psql restore failed for database '$db_name' in container '$container'"

  info "  Postgres restore complete for '$db_name'"
}

restore_mongo() {
  local svc_name="$1"
  local source_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${source_dir}/dump.archive"

  if [[ ! -f "$dump_file" ]]; then
    fail "MongoDB dump file not found: $dump_file"
  fi

  info "  Restoring MongoDB database '$db_name' in container '$container'..."

  # Drop the database first to ensure a clean restore
  docker exec "$container" \
    mongosh -u "$db_user" -p "$db_password" --authenticationDatabase admin \
      --quiet --eval "db.getSiblingDB('$db_name').dropDatabase()" \
    || fail "Failed to drop MongoDB database '$db_name' in container '$container'"

  docker exec -i "$container" \
    mongorestore \
      --username "$db_user" \
      --password "$db_password" \
      --authenticationDatabase admin \
      --drop \
      --archive < "$dump_file" \
    || fail "mongorestore failed for database '$db_name' in container '$container'"

  info "  MongoDB restore complete for '$db_name'"
}

restore_mysql() {
  local svc_name="$1"
  local source_dir="$2"

  local container db_user db_password db_name

  container="$(require_svc_var "$svc_name" "CONTAINER")"
  db_user="$(require_svc_var "$svc_name" "USER")"
  db_password="$(require_svc_var "$svc_name" "PASSWORD")"
  db_name="$(require_svc_var "$svc_name" "DB")"

  local dump_file="${source_dir}/dump.sql"

  if [[ ! -f "$dump_file" ]]; then
    fail "MySQL dump file not found: $dump_file"
  fi

  info "  Restoring MySQL database '$db_name' in container '$container'..."

  # Drop and recreate the database to ensure a clean restore.
  # Backticks quote the identifier; they are escaped so bash does not run them.
  docker exec -e MYSQL_PWD="$db_password" "$container" \
