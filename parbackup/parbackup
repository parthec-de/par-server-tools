backup_volume() {
  local svc_name="$1"
  local target_dir="$2"

  local container path
  container="$(require_svc_var "$svc_name" "CONTAINER")"
  path="$(require_svc_var "$svc_name" "PATH")"

  info "  Copying '$path' from container '$container'..."

  # A tar stream keeps owner and mode, a plain 'docker cp' to the host resets them to the caller
  docker cp "$container:$path/." - > "$target_dir/volume.tar" \
    2> >(_tee_to_log "docker cp") \
    || fail "docker cp failed for '$path' from container '$container'"

  info "  Volume data saved to $target_dir"
}

restore_volume() {
  local svc_name="$1"
  local source_dir="$2"

  local container path
  container="$(require_svc_var "$svc_name" "CONTAINER")"
  path="$(require_svc_var "$svc_name" "PATH")"

  info "  Restoring '$path' in container '$container'..."

  # Clear existing files, then copy backup contents into the volume
  docker exec "$container" sh -c "rm -rf '${path:?}/'*" \
    || fail "Failed to clear '$path' in container '$container'"
  if [[ -f "$source_dir/volume.tar" ]]; then
    docker cp - "$container:$path/" < "$source_dir/volume.tar" \
      || fail "docker cp failed for '$path' into container '$container'"
  else
    # Archives before v1.7.0 hold plain files without owner information
    warn "  No volume.tar found, restoring plain files, ownership falls back to root"
    docker cp "$source_dir/." "$container:$path/" \
      || fail "docker cp failed for '$path' into container '$container'"
  fi

  info "  Volume restore complete for '$path'"
}

# Restore volume files from a directory, e.g. the tree of a restic snapshot.
restore_volume_from_dir() {
  local svc_name="$1"
  local source_dir="$2"

  local container path
  container="$(require_svc_var "$svc_name" "CONTAINER")"
  path="$(require_svc_var "$svc_name" "PATH")"

  if [[ ! -d "$source_dir" ]]; then
    fail "Volume data not found: $source_dir"
  fi

  info "  Restoring '$path' in container '$container'..."

  docker exec "$container" sh -c "rm -rf '${path:?}/'*" \
    || fail "Failed to clear '$path' in container '$container'"

  # A tar stream keeps owner and mode, a plain docker cp resets them to the caller
  tar -C "$source_dir" -cf - . \
    | docker cp - "$container:$path/" \
    || fail "docker cp failed for '$path' into container '$container'"

  info "  Volume restore complete for '$path'"
}

backup_dir() {
  local svc_name="$1"
  local target_dir="$2"

  local dir_path
  dir_path="$(require_svc_var "$svc_name" "PATH")"

  if [[ ! -d "$dir_path" ]]; then
    fail "Directory '$dir_path' does not exist"
  fi

  info "  Copying '$dir_path'..."

  cp -a "$dir_path/." "$target_dir/" \
    2> >(_tee_to_log "cp")

  info "  Directory saved to $target_dir"
}

restore_dir() {
  local svc_name="$1"
  local source_dir="$2"

  local dir_path
  dir_path="$(require_svc_var "$svc_name" "PATH")"

  info "  Restoring '$dir_path'..."

  install_rsync

  # Sync backup contents into target, deleting extraneous files
  rsync -a --delete "$source_dir/" "$dir_path/"

  info "  Directory restore complete for '$dir_path'"
}

command_ls_restic() {
  local prefix="$1"
  local timestamps="$2"

  require_config
  require_restic_config

  local repo_prefix s3_path
  repo_prefix="$(restic_repo_prefix)"
  s3_path="s3://${S3_BUCKET}${repo_prefix:+/$repo_prefix}"
  info "Listing restic snapshots in ${s3_path}/${prefix}..."

  local rows
  if [[ -n "$prefix" ]]; then
    local name="${prefix%/}"
    if ! restic_repo_exists "$(restic_repository_for "$name")"; then
      info "No backups found."
      return 0
    fi
    rows="$(restic_snapshot_rows "$(restic_repository_for "$name")" \
      | awk -F'\t' -v name="$name" '{ print $1 "\t" name "/" $2 }')"
  else
    rows="$(restic_all_snapshot_rows)"
  fi

  if [[ -z "$rows" ]]; then
    info "No backups found."
    return 0
  fi

  if [[ "$timestamps" == true ]]; then
    echo "$rows"
  else
    echo "$rows" | format_snapshot_refs
  fi
}

command_ls() {
  local tree=false
  local timestamps=false
  local prefix=""

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tree)
        tree=true
        shift
        ;;
      --timestamps)
        timestamps=true
        shift
        ;;
      *)
        prefix="$1"
        shift
        ;;
    esac
  done

  load_config || true

  if [[ "$(backend)" == restic ]]; then
    command_ls_restic "$prefix" "$timestamps"
    return 0
  fi

  require_config

  info "Listing backups on s3://${S3_BUCKET}/${prefix}..."

  local file_list
  file_list="$(s3_cmd ls --recursive "s3://${S3_BUCKET}/${prefix}" 2> >(_tee_to_log "s3 ls"))"

  if [[ -z "$file_list" ]]; then
    info "No backups found."
    return 0
  fi

  if [[ "$timestamps" == true ]]; then
    # Output: <epoch>\t<key> — timestamp from s3cmd ls date columns
    while IFS= read -r line; do
      local file_date file_key epoch
      file_date="$(echo "$line" | awk '{print $1, $2}')"
      file_key="$(echo "$line" | awk '{print $NF}' | cut -d/ -f4-)"
      epoch="$(date -d "$file_date" +%s 2> /dev/null || true)"
      [[ -n "$epoch" ]] && echo -e "${epoch}\t${file_key}"
    done <<< "$file_list"
  else
    # Extract plain keys from s3cmd output (strip s3://bucket/ prefix)
    local keys
    keys="$(echo "$file_list" | awk '{print $NF}' | cut -d/ -f4-)"

    if [[ "$tree" == true ]]; then
      local root_dirs
      root_dirs="$(echo "$keys" | cut -d/ -f1 | sort -u)"

      for dir_name in $root_dirs; do
        echo "$dir_name"
        echo "$keys" \
          | grep "^${dir_name}/" \
          | cut -d/ -f2- \
          | sed '$ s/^/└─ /; $ ! s/^/├─ /'
      done
    else
      echo "$keys"
    fi
  fi
}

command_cleanup() {
  local dry_run=false
  local backupfile=""
  local backend_override=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=true
        shift
        ;;
      --backend)
        backend_override="$2"
        shift 2
        ;;
      -f | --file)
        backupfile="$2"
        shift 2
        ;;
      *)
        error "Unknown option: $1"
        exit 1
        ;;
    esac
  done

  load_config || true
  require_config

  # Pin the backend for this run, command_ls must follow the same choice
  if [[ -n "$backend_override" ]]; then
    BACKEND_OVERRIDE="$backend_override"
  fi

  local selected_backend
  selected_backend="$(backend)"

  # With a Parbackupfile, only its own backups are cleaned up, using its RETENTION_DAYS
  local scope=""
  local retention_days="${RETENTION_DAYS:-0}"
  if [[ -n "$backupfile" ]]; then
    require_parbackupfile "$backupfile"
    scope="$BACKUP_NAME"
    retention_days="$(effective_retention_days)"
    warn_unused_retention
  fi

  if [[ "$retention_days" == "0" || -z "$retention_days" ]]; then
    info "Retention is disabled (RETENTION_DAYS=0). Nothing to clean up."
    return 0
  fi
  local retention_seconds=$((retention_days * 86400))

  local now="${_NOW:-$(date +%s)}"
  local cutoff=$((now - retention_seconds))

  if [[ -n "$scope" ]]; then
    info "Cleaning up backups of '${scope}' older than ${retention_days} day(s)..."
  else
    info "Cleaning up backups older than ${retention_days} day(s)..."
  fi

  # --- Clean up old local temp files in working_dir ---
  local tmp_deleted=0

  if [[ -d "$working_dir" ]]; then
    for item in "$working_dir"/*; do
      [[ -e "$item" ]] || continue
      # Skip the runs directory itself (only its contents are cleaned below)
      [[ "$item" == "$run_log_dir" ]] && continue
      # Matching the timestamp keeps "test" from also catching "test-foo"
      if [[ -n "$scope" && "$(basename "$item")" != "${scope}"-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_* ]]; then
        continue
      fi

      local item_mtime
      item_mtime="$(stat -c '%Y' "$item" 2> /dev/null)" || continue
      if ((item_mtime < cutoff)); then
        if $dry_run; then
          info "Would delete temp: $item"
        else
          info "Deleting old temp: $item"
          rm -rf "$item"
        fi
        tmp_deleted=$((tmp_deleted + 1))
      fi
    done

    # Clean old files inside runs/ (keep the directory itself)
    if [[ -d "$run_log_dir" ]]; then
      for item in "$run_log_dir"/*; do
        [[ -e "$item" ]] || continue

        local item_mtime
        item_mtime="$(stat -c '%Y' "$item" 2> /dev/null)" || continue
        if ((item_mtime < cutoff)); then
          if $dry_run; then
            info "Would delete run log: $item"
          else
            info "Deleting old run log: $item"
            rm -f "$item"
          fi
          tmp_deleted=$((tmp_deleted + 1))
        fi
      done
    fi
  fi

  if ((tmp_deleted > 0)); then
    if $dry_run; then
      info "Would delete $tmp_deleted old temp file(s)."
    else
      info "Deleted $tmp_deleted old temp file(s)."
    fi
  fi

  # --- Clean up old remote backups ---
  if [[ "$selected_backend" == restic ]]; then
    command_cleanup_restic "$backupfile" "$dry_run" "$retention_days"
    return 0
  fi

  local ts_list
  ts_list="$(command_ls --timestamps "${scope:+${scope}/}" 2> /dev/null)"

  if [[ -z "$ts_list" ]]; then
    info "No remote backups found."
  else
    local s3_deleted=0

    while IFS=$'\t' read -r epoch key; do
      [[ -z "$epoch" || -z "$key" ]] && continue

      if ((epoch < cutoff)); then
        if $dry_run; then
          info "Would delete: $key"
        else
          info "Deleting old backup: $key"
          s3_cmd del "s3://${S3_BUCKET}/${key}" 2> >(_tee_to_log "s3 del")
        fi
        s3_deleted=$((s3_deleted + 1))
      fi
    done <<< "$ts_list"

    if ((s3_deleted > 0)); then
      if $dry_run; then
        info "Would delete $s3_deleted old remote backup(s)."
      else
        info "Deleted $s3_deleted old remote backup(s)."
      fi
    else
      info "No old remote backups to delete."
    fi
  fi
}

# Forget restic snapshots beyond the retention. Prune frees the space right away.
command_cleanup_restic() {
  local backupfile="$1"
  local dry_run="$2"
  local retention_days="$3"

  local -a names=()
  local retention_weekly retention_monthly

  if [[ -n "$backupfile" ]]; then
    names+=("$BACKUP_NAME")
    retention_weekly="$(effective_retention_weekly)"
    retention_monthly="$(effective_retention_monthly)"
  else
    mapfile -t names < <(restic_repo_names | sort)
    retention_weekly="${RETENTION_WEEKLY:-}"
    retention_monthly="${RETENTION_MONTHLY:-}"
  fi

  if [[ ${#names[@]} -eq 0 ]]; then
    info "No restic repositories found."
    return 0
  fi

  require_restic_config

  local name
  for name in "${names[@]}"; do
    local repository
    repository="$(restic_repository_for "$name")"

    if ! restic_repo_exists "$repository"; then
      warn "No restic repository at $repository"
      continue
    fi

    local -a forget_args=(--tag "$name" --keep-daily "$retention_days")
    [[ -n "$retention_weekly" ]] && forget_args+=(--keep-weekly "$retention_weekly")
    [[ -n "$retention_monthly" ]] && forget_args+=(--keep-monthly "$retention_monthly")

    if [[ "$dry_run" == true ]]; then
      info "Would forget snapshots of '$name' beyond retention..."
      forget_args+=(--dry-run)
    else
      info "Forgetting snapshots of '$name' beyond retention and pruning..."
      forget_args+=(--prune --max-unused 10%)
    fi

    restic_cmd "$repository" forget "${forget_args[@]}" \
      2>&1 | _tee_to_log "restic forget"
  done
}

# Prune the repositories of one Parbackupfile or of the whole base.
command_restic_prune() {
  local backupfile=""
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=true
        shift
        ;;
      -f | --file)
        backupfile="$2"
        shift 2
        ;;
      -h | --help)
        print_restic_help
        exit 0
        ;;
      *)
        fail_restic_help "Unknown option '$1' for 'restic prune'"
        ;;
    esac
  done

  load_config || true

  if [[ -n "$backupfile" ]]; then
    require_parbackupfile "$backupfile"
  fi

  require_config
  require_restic_config

  local -a names=()
  if [[ -n "$backupfile" ]]; then
    names+=("$BACKUP_NAME")
  else
    mapfile -t names < <(restic_repo_names | sort)
  fi

  if [[ ${#names[@]} -eq 0 ]]; then
    info "No restic repositories found."
    return 0
  fi

  local name
  for name in "${names[@]}"; do
    local repository
    repository="$(restic_repository_for "$name")"

    if ! restic_repo_exists "$repository"; then
      warn "No restic repository at $repository"
      continue
    fi

    local -a prune_args=(--max-unused 10%)
    [[ "$dry_run" == true ]] && prune_args+=(--dry-run)

    info "Pruning restic repository $repository..."
    restic_cmd "$repository" prune "${prune_args[@]}" \
      2>&1 | _tee_to_log "restic prune"
  done
}

