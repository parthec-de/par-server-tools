  restic_init_repository "$repository"
  info "Repository ready: $repository"
}

# --- restic subcommands ---

print_restic_help() {
  cat << EOF
$script_name v$script_version -- restic repository maintenance

Usage: parbackup restic <command> [options]

Commands:
  init      Create the restic repository of a Parbackupfile
  prune     Release the space of forgotten snapshots
  check     Verify a restic repository

Options:
  init:
    -f, --file <path>  Parbackupfile whose repository to create

  prune:
    --dry-run          Show what prune would free, without rewriting packs
    -f, --file <path>  Only prune the repository of this Parbackupfile

  check:
    --read-data-subset <value>  Read a share of the packs, e.g. 1/7 or 5%
    -f, --file <path>  Only check the repository of this Parbackupfile

Examples:
  parbackup restic init -f /opt/my-project/Parbackupfile
  parbackup restic prune -f /opt/my-project/Parbackupfile
  parbackup restic prune --dry-run
  parbackup restic check -f /opt/my-project/Parbackupfile --read-data-subset 1/7
EOF
}

fail_restic_help() {
  error "$1"
  echo ""
  print_restic_help
  exit 1
}

command_restic() {
  local subcmd="${1:-}"

  case "$subcmd" in
    init)
      shift
      command_restic_init "$@"
      ;;
    prune)
      shift
      command_restic_prune "$@"
      ;;
    check)
      shift
      command_restic_check "$@"
      ;;
    "" | help | -h | --help)
      print_restic_help
      ;;
    *)
      fail_restic_help "Unknown restic command '$subcmd'. Use 'restic init', 'restic prune' or 'restic check'."
      ;;
  esac
}

_create_error_handler() {
  local exit_code=$?
  if [[ $exit_code -ne 0 ]]; then
    local deployment_name="${1:-unknown}"
    local line_nr="${2:-unknown}"

    local body="Backup for deployment '${deployment_name}' failed with exit code ${exit_code} (near line ${line_nr})."

    # Append run log content if available
    if [[ -n "${RUN_LOG_FILE:-}" && -f "$RUN_LOG_FILE" ]]; then
      body+="

--- Run log ---
$(cat "$RUN_LOG_FILE")"
    else
      body+="

Check the backup host for details."
    fi

    # Delegate alerting to the standalone paralert tool (assumed installed on PATH).
    # Never let a missing/failing alert abort the exit handler.
    paralert send \
      --subject "[parbackup] Backup FAILED for '${deployment_name}'" \
      --body "$body" || true
  fi
  # Reset trap to avoid re-triggering
  trap - EXIT
}

command_create() {
  ensure_working_dir

  local local_only=false
  local keep_local=false
  local no_prune=false
  local backupfile=""

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        local_only=true
        shift
        ;;
      --keep-local)
        keep_local=true
        shift
        ;;
      --no-prune)
        no_prune=true
        shift
        ;;
      -f | --file)
        backupfile="$2"
        shift 2
        ;;
      *)
        fail_help "Unknown option '$1' for create command"
        ;;
    esac
  done

  load_config || true

  # Require S3 config unless --local
  if [[ "$local_only" != true ]]; then
    require_config
  fi

  # Set up error notification: on non-zero exit, send an email alert
  trap '_create_error_handler "${BACKUP_NAME:-unknown}" "$LINENO"' EXIT

  # Start the run log early so require_parbackupfile errors are captured.
  mkdir -p "$run_log_dir"
  RUN_LOG_FILE="$(mktemp "${run_log_dir}/run-XXXXXXXXXX.log")"
  _log_to_file "INFO" "Command: $script_invocation"
  _log_to_file "INFO" "Working directory: $(pwd)"

  if [[ -n "$backupfile" ]]; then
    require_parbackupfile "$backupfile"
  else
    require_parbackupfile
    backupfile="./$parbackupfile_name"
  fi

  warn_unused_retention

  if [[ "$(backend)" == restic ]]; then
    command_create_restic "$backupfile" "$local_only" "$keep_local" "$no_prune"
    return 0
  fi

  if [[ "$no_prune" == true ]]; then
    warn "--no-prune has no effect with BACKUP_BACKEND=builtin"
  fi

  local timestamp
  timestamp="$(date +%Y-%m-%d_%H-%M-%S)"
  info "Run log: $RUN_LOG_FILE"

  local backup_name="${BACKUP_NAME}-${timestamp}"
  local backup_dir="${working_dir}/${backup_name}"

  info "Creating backup: $backup_dir"
  mkdir -p "$backup_dir"

  # Enable logging to file inside the backup directory
  BACKUP_LOG_FILE="${backup_dir}/parbackup.log"
  info "Logging to $BACKUP_LOG_FILE"

  # Save the Parbackupfile into the backup directory (always stored as "Parbackupfile")
  cp "$backupfile" "$backup_dir/Parbackupfile"
  info "Saved $backupfile to backup directory"

  # Iterate over services
  IFS=',' read -ra svc_list <<< "$SERVICES"

  for svc_name in "${svc_list[@]}"; do
    # Trim whitespace
    svc_name="$(echo "$svc_name" | xargs)"

    local svc_type
    svc_type="$(require_svc_var "$svc_name" "TYPE")"

    info "Processing service '$svc_name' (type: $svc_type)..."

    local svc_target_dir="${backup_dir}/${svc_name}"
    mkdir -p "$svc_target_dir"

    case "$svc_type" in
      postgres)
        backup_postgres "$svc_name" "$svc_target_dir"
        ;;
      mongo)
        backup_mongo "$svc_name" "$svc_target_dir"
        ;;
      mysql)
        backup_mysql "$svc_name" "$svc_target_dir"
        ;;
      volume)
        backup_volume "$svc_name" "$svc_target_dir"
        ;;
      dir)
        backup_dir "$svc_name" "$svc_target_dir"
        ;;
      *)
        fail "Unknown service type '$svc_type' for service '$svc_name'"
        ;;
    esac
  done

  # Package as tar.gz
  local archive="${working_dir}/${backup_name}.tar.gz"
  info "Packaging backup: $archive"

  # Disable backup log before packaging (log file is inside the backup dir)
  BACKUP_LOG_FILE=""

  tar -czf "$archive" -C "$working_dir" "$backup_name" 2> >(_tee_to_log "tar")

  # Clean up uncompressed directory
  rm -rf "$backup_dir"
  info "Removed temporary directory $backup_dir"

  # Upload to S3
  local result="$archive"
  if [[ "$local_only" != true ]]; then
    local s3_key="${BACKUP_NAME}/${backup_name}.tar.gz"
    info "Uploading to S3: s3://${S3_BUCKET}/${s3_key}"
    s3_upload "$archive" "$s3_key"
    info "S3 upload complete"

    # The S3 copy is enough, local copies would fill the disk over the retention period
    if [[ "$keep_local" != true ]]; then
      rm -f "$archive"
      info "Removed local archive $archive"
      result="s3://${S3_BUCKET}/${s3_key}"
    fi

    # Auto-cleanup old backups of this Parbackupfile only
    command_cleanup -f "$backupfile"
  fi

  # Clear error notification trap on success
  trap - EXIT

  info "Backup complete: $result"

  # Clean up the run log on success
  rm -f "$RUN_LOG_FILE"
  RUN_LOG_FILE=""
}

# --- create with the restic backend ---

command_create_restic() {
  local backupfile="$1"
  local local_only="$2"
  local keep_local="$3"
  local no_prune="$4"

  local staging="${restic_staging_root}/${BACKUP_NAME}"
  local repository=""

  if [[ "$local_only" != true ]]; then
    require_restic_config
    repository="$(restic_repository_for "$BACKUP_NAME")"
  fi

  info "Creating backup: $staging"
  rm -rf "$staging"
  mkdir -p "$staging"

  # Enable logging to file inside the staging directory
  BACKUP_LOG_FILE="${staging}/parbackup.log"
  info "Logging to $BACKUP_LOG_FILE"

  # Save the Parbackupfile into the staging directory (always stored as "Parbackupfile")
  cp "$backupfile" "$staging/Parbackupfile"
  info "Saved $backupfile to backup directory"

  # Docker volumes and host directories are read in place, the manifest keeps the map
  local -a paths=("$staging")

  IFS=',' read -ra svc_list <<< "$SERVICES"

  for svc_name in "${svc_list[@]}"; do
    svc_name="$(echo "$svc_name" | xargs)"

    local svc_type
    svc_type="$(require_svc_var "$svc_name" "TYPE")"

    info "Processing service '$svc_name' (type: $svc_type)..."

    local svc_target_dir="${staging}/${svc_name}"
    mkdir -p "$svc_target_dir"

    local host_path=""

    case "$svc_type" in
      postgres)
        backup_postgres "$svc_name" "$svc_target_dir"
        ;;
      mongo)
        backup_mongo "$svc_name" "$svc_target_dir"
        ;;
      mysql)
        backup_mysql "$svc_name" "$svc_target_dir"
        ;;
      volume)
        host_path="$(resolve_host_path "$svc_name" || true)"
        if [[ -n "$host_path" ]]; then
          info "  Reading '$host_path' in place"
          record_manifest_entry "$staging" "$svc_name" volume "$host_path"
          paths+=("$host_path")
        else
          warn "  '$svc_name' is not a volume mount, falling back to docker cp"
          backup_volume "$svc_name" "$svc_target_dir"
        fi
        ;;
      dir)
        host_path="$(require_svc_var "$svc_name" "PATH")"
        if [[ ! -d "$host_path" ]]; then
          fail "Directory '$host_path' does not exist"
        fi
        info "  Reading '$host_path' in place"
        record_manifest_entry "$staging" "$svc_name" dir "$host_path"
        paths+=("$host_path")
        ;;
      *)
        fail "Unknown service type '$svc_type' for service '$svc_name'"
        ;;
    esac
  done

  # Disable the backup log before restic reads the staging tree
  BACKUP_LOG_FILE=""

  if [[ "$local_only" == true ]]; then
    trap - EXIT
    info "Backup staged: $staging"
    rm -f "$RUN_LOG_FILE"
    RUN_LOG_FILE=""
    return 0
  fi

  local -a unique_paths=()
  mapfile -t unique_paths < <(printf '%s\n' "${paths[@]}" | awk '!seen[$0]++')

  restic_init_repository "$repository"

  info "Uploading to restic repository $repository"
  restic_cmd "$repository" backup \
    --tag "$BACKUP_NAME" \
    --host "$BACKUP_NAME" \
    "${unique_paths[@]}" \
    2>&1 | _tee_to_log "restic backup"

  local retention_days retention_weekly retention_monthly
  retention_days="$(effective_retention_days)"
  retention_weekly="$(effective_retention_weekly)"
  retention_monthly="$(effective_retention_monthly)"

  if [[ -z "$retention_days" || "$retention_days" == "0" ]]; then
    info "Retention is disabled (RETENTION_DAYS=0). No snapshots are forgotten."
  else
    local -a forget_args=(--tag "$BACKUP_NAME" --keep-daily "$retention_days")
    [[ -n "$retention_weekly" ]] && forget_args+=(--keep-weekly "$retention_weekly")
    [[ -n "$retention_monthly" ]] && forget_args+=(--keep-monthly "$retention_monthly")

    if [[ "$no_prune" == true ]]; then
      info "Forgetting snapshots beyond retention, prune is disabled (--no-prune)"
    else
      info "Forgetting snapshots beyond retention and pruning"
      forget_args+=(--prune --max-unused 10%)
    fi

    restic_cmd "$repository" forget "${forget_args[@]}" \
      2>&1 | _tee_to_log "restic forget"
  fi

  # The snapshot holds the data, the staging tree only needs its paths to stay
  if [[ "$keep_local" != true ]]; then
    find "$staging" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    info "Removed staging contents of $staging"
  fi

  # Clear error notification trap on success
  trap - EXIT

  info "Backup complete: restic snapshot of '$BACKUP_NAME' in $repository"

  rm -f "$RUN_LOG_FILE"
  RUN_LOG_FILE=""
}

_sq() {
  # Escape a value for safe use inside single quotes: replace ' with '\''
  printf '%s' "${1//\'/\'\\\'\'}"
}

save_config() {
  mkdir -p "$config_dir"
  cat > "$config_file" << EOF
# parbackup configuration
BACKUP_BACKEND='$(_sq "${BACKUP_BACKEND:-builtin}")'
S3_ENDPOINT='$(_sq "${S3_ENDPOINT:-}")'
S3_BUCKET='$(_sq "${S3_BUCKET:-}")'
S3_ACCESS_KEY='$(_sq "${S3_ACCESS_KEY:-}")'
S3_SECRET_KEY='$(_sq "${S3_SECRET_KEY:-}")'
S3_REGION='$(_sq "${S3_REGION:-}")'
RESTIC_REPO_PREFIX='$(_sq "${RESTIC_REPO_PREFIX:-restic}")'
RESTIC_SECRET_FILE='$(_sq "${RESTIC_SECRET_FILE:-}")'
RESTIC_CACHE_DIR='$(_sq "${RESTIC_CACHE_DIR:-}")'
RETENTION_DAYS='$(_sq "${RETENTION_DAYS:-7}")'
RETENTION_WEEKLY='$(_sq "${RETENTION_WEEKLY:-}")'
RETENTION_MONTHLY='$(_sq "${RETENTION_MONTHLY:-}")'
EOF
  chmod 600 "$config_file"
  info "Config saved to $config_file"
}

config_set_s3() {
  info "Configuring S3 backend..."

  S3_ENDPOINT="$(gum input --placeholder "https://fsn1.your-objectstorage.com" \
    --header "S3 Endpoint URL" --value "${S3_ENDPOINT:-}")"
  S3_BUCKET="$(gum input --placeholder "my-backups" \
    --header "S3 Bucket Name" --value "${S3_BUCKET:-}")"
  S3_ACCESS_KEY="$(gum input --placeholder "access key" \
    --header "S3 Access Key" --value "${S3_ACCESS_KEY:-}")"
  S3_SECRET_KEY="$(gum input --placeholder "secret key" --password \
    --header "S3 Secret Key" --value "${S3_SECRET_KEY:-}")"
  S3_REGION="$(gum input --placeholder "empty = provider default" \
    --header "S3 Region (optional, e.g. us-east-1)" --value "${S3_REGION:-}")"
  RETENTION_DAYS="$(gum input --placeholder "7" \
    --header "Retention period in days (0 = disabled)" --value "${RETENTION_DAYS:-7}")"

  save_config
}

write_restic_secret() {
  local secret
  secret="$(restic_secret_file)"

  if [[ -f "$secret" ]]; then
    info "Secret file already exists: $secret"
    warn "Without this password the backups cannot be restored. Keep a copy outside this host."
    return 0
  fi

  mkdir -p "$(dirname "$secret")"
  local password
  password="$(gum input --password --placeholder "repository password" \
    --header "Restic repository password")"

  if [[ -z "$password" ]]; then
    fail "No password entered, the restic backend cannot be used without one."
  fi

  (umask 077 && printf '%s\n' "$password" > "$secret")

  info "Secret saved to $secret"
  warn "Without this password the backups cannot be restored. Keep a copy outside this host."
}

config_set_restic() {
  info "Configuring restic backend..."

  BACKUP_BACKEND="$(gum choose --header "Default backup backend" "builtin" "restic")"
  RESTIC_REPO_PREFIX="$(gum input --placeholder "restic" \
    --header "Prefix in the bucket for the restic repositories" --value "${RESTIC_REPO_PREFIX:-restic}")"
  RESTIC_SECRET_FILE="$(gum input --placeholder "${config_dir}/restic-secret" \
    --header "Secret file with the repository password" --value "${RESTIC_SECRET_FILE:-}")"
  RESTIC_CACHE_DIR="$(gum input --placeholder "/var/cache/parbackup/restic" \
    --header "Restic cache directory" --value "${RESTIC_CACHE_DIR:-}")"
  RETENTION_DAYS="$(gum input --placeholder "7" \
    --header "Retention: keep-daily (0 = keep forever)" --value "${RETENTION_DAYS:-7}")"
  RETENTION_WEEKLY="$(gum input --placeholder "empty = unset" \
    --header "Retention: keep-weekly" --value "${RETENTION_WEEKLY:-}")"
  RETENTION_MONTHLY="$(gum input --placeholder "empty = unset" \
    --header "Retention: keep-monthly" --value "${RETENTION_MONTHLY:-}")"

  save_config

  if [[ "$BACKUP_BACKEND" == restic ]]; then
    write_restic_secret
  fi
}

command_config() {
  local subcmd="${1:-}"
  local section="${2:-}"

  # Load existing config to preserve values when saving
  load_config || true

  case "$subcmd" in
    set)
      case "$section" in
        s3)
          config_set_s3
          ;;
        restic)
          config_set_restic
          ;;
        "")
          config_set_s3
          config_set_restic
          ;;
        *)
          fail_help "Unknown config section '$section'. Use 'config set', 'config set s3' or 'config set restic'."
          ;;
      esac
      ;;

    "")
      if [[ ! -f "$config_file" ]]; then
        warn "No config found at $config_file"
        info "Run 'parbackup config set' to configure."
        return 0
      fi
      echo "Config: $config_file"
      echo ""
      echo "BACKUP_BACKEND   = ${BACKUP_BACKEND:-builtin}"
      echo "S3_ENDPOINT      = ${S3_ENDPOINT:-<not set>}"
      echo "S3_BUCKET        = ${S3_BUCKET:-<not set>}"
      echo "S3_ACCESS_KEY    = $(mask_secret "${S3_ACCESS_KEY:-}")"
      echo "S3_SECRET_KEY    = $(mask_secret "${S3_SECRET_KEY:-}")"
      echo "S3_REGION        = ${S3_REGION:-<not set>}"
      echo "RESTIC_REPO_PREFIX  = $(restic_repo_prefix)"
      echo "RESTIC_SECRET_FILE  = $(restic_secret_file)"
      echo "RESTIC_CACHE_DIR    = $(restic_cache_dir)"
      echo "RETENTION_DAYS   = ${RETENTION_DAYS:-<not set>}"
      echo "RETENTION_WEEKLY = ${RETENTION_WEEKLY:-<not set>}"
      echo "RETENTION_MONTHLY = ${RETENTION_MONTHLY:-<not set>}"
      ;;

    *)
      fail_help "Unknown config subcommand '$subcmd'. Use 'config' or 'config set'."
      ;;
  esac
}

command_cron() {
  local subcmd=""
  local backupfile=""
  local schedule_arg=""

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f | --file)
        backupfile="$2"
        shift 2
        ;;
      --schedule)
        schedule_arg="$2"
        shift 2
        ;;
      *)
        if [[ -z "$subcmd" ]]; then
          subcmd="$1"
        else
          fail_help "Unknown option '$1' for cron command"
        fi
        shift
        ;;
    esac
  done

  local script_path
  script_path="$(readlink -f "$0")"

  case "${subcmd:-}" in
    show)
      info "Current parbackup cron entries:"
      echo ""
      local entries
      entries="$(crontab -l 2> /dev/null | grep "# parbackup:" || true)"
      if [[ -z "$entries" ]]; then
        info "No parbackup cron entries found."
      else
        echo "$entries"
      fi
      ;;

    remove)
      if [[ -z "$backupfile" ]]; then
        fail "Missing required option: -f <path>"
      fi

      if [[ ! -f "$backupfile" ]]; then
        fail "Parbackupfile not found: $backupfile"
      fi

      # Load Parbackupfile to get BACKUP_NAME for the marker
      require_parbackupfile "$backupfile"
      local marker="# parbackup:${BACKUP_NAME}"

      local current_crontab
      current_crontab="$(crontab -l 2> /dev/null || true)"

      if ! echo "$current_crontab" | grep -q "${marker}$"; then
        info "No cron entry found for '$BACKUP_NAME'."
        return 0
      fi

      local new_crontab
      new_crontab="$(echo "$current_crontab" | grep -v "${marker}$" || true)"

      if [[ -n "$new_crontab" ]]; then
        echo "$new_crontab" | crontab -
      else
        crontab -r 2> /dev/null || true
      fi
      info "Removed cron entry for '$BACKUP_NAME'."
      ;;

    "")
      # Default: add or update cron entry
      if [[ -z "$backupfile" ]]; then
        fail "Missing required option: -f <path>"
      fi

      if [[ ! -f "$backupfile" ]]; then
        fail "Parbackupfile not found: $backupfile"
      fi

      local abs_backupfile
      abs_backupfile="$(realpath "$backupfile")"

      # Load Parbackupfile to get BACKUP_NAME for the marker
      require_parbackupfile "$abs_backupfile"
      local marker="# parbackup:${BACKUP_NAME}"

      # Choose frequency
      local schedule
      if [[ -n "$schedule_arg" ]]; then
        schedule="$schedule_arg"
      else
        local choice
        choice="$(gum choose \
          "Daily at 3:00 AM" \
          "Daily at midnight" \
          "Every 12 hours" \
          "Custom")"

        case "$choice" in
          "Daily at 3:00 AM")   schedule="0 3 * * *" ;;
          "Daily at midnight")  schedule="0 0 * * *" ;;
          "Every 12 hours")     schedule="0 */12 * * *" ;;
          "Custom")
            schedule="$(gum input --placeholder "0 3 * * *" --header "Enter cron schedule (5 fields)")"
            if [[ -z "$schedule" ]]; then
              fail "No schedule provided."
            fi
            ;;
        esac
      fi

      local cron_line="${schedule} ${script_path} create -f ${abs_backupfile} ${marker}"

      local current_crontab
      current_crontab="$(crontab -l 2> /dev/null || true)"

      local new_crontab
      if echo "$current_crontab" | grep -q "${marker}$"; then
        # Update existing entry
        new_crontab="$(echo "$current_crontab" | grep -v "${marker}$" || true)"
        if [[ -n "$new_crontab" ]]; then
          new_crontab="${new_crontab}
${cron_line}"
        else
          new_crontab="$cron_line"
        fi
        info "Updating existing cron entry for '$BACKUP_NAME'."
      else
        # Append new entry
        if [[ -n "$current_crontab" ]]; then
          new_crontab="${current_crontab}
${cron_line}"
        else
          new_crontab="$cron_line"
        fi
        info "Adding cron entry for '$BACKUP_NAME'."
      fi

      echo "$new_crontab" | crontab -
      info "Cron entry set: $cron_line"
      ;;

    *)
      fail_help "Unknown cron subcommand '$subcmd'. Use 'cron', 'cron show', or 'cron remove'."
      ;;
  esac
}

command_download() {
  ensure_working_dir

  local force=false
  local pick=false
  local backup_ref=""

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f | --force)
        force=true
        shift
        ;;
      --pick)
        pick=true
        shift
        ;;
      *)
        backup_ref="$1"
        shift
        ;;
    esac
  done

  if [[ "$pick" == true ]]; then
    if [[ -n "$backup_ref" ]]; then
      fail "--pick does not accept a backup reference argument"
    fi

    load_config || true

    local keys
    keys="$(command_ls 2> /dev/null)"

    if [[ -z "$keys" ]]; then
      fail "No backups found."
    fi

    backup_ref="$(echo "$keys" | gum filter)"
    # The restic listing prefixes a human readable time, the key follows a tab
    backup_ref="${backup_ref##*$'\t'}"

    if [[ -z "$backup_ref" ]]; then
      info "No backup selected."
      exit 0
    fi
  fi

  if [[ -z "$backup_ref" ]]; then
    fail_help "Missing required argument: <backup_ref>"
  fi

  load_config || true

  if [[ "$(backend)" == restic ]]; then
    require_config
    require_restic_config

    local repo_name snapshot_id
    parse_snapshot_ref "$backup_ref"
    repo_name="$RESTORE_REPO_NAME"
    snapshot_id="$RESTORE_SNAPSHOT"

    local target="${working_dir}/${repo_name}-${snapshot_id}"

    if [[ -e "$target" ]]; then
      warn "Directory already exists: $target"
      if [[ "$force" == true ]] || gum confirm --default=No "Overwrite?"; then
        rm -rf "$target"
      else
        info "Download cancelled."
        exit 0
      fi
    fi

    local repository
    repository="$(restic_repository_for "$repo_name")"
    if ! restic_repo_exists "$repository"; then
      fail "No restic repository at $repository"
    fi

    restic_restore_snapshot "$repository" "$snapshot_id" "$target" "$repo_name" > /dev/null
    info "Downloaded to $target"
    echo "$target"
    return 0
  fi

  require_config

  local local_archive="${working_dir}/$(basename "$backup_ref")"

  if [[ -f "$local_archive" ]]; then
    warn "File already exists: $local_archive"
    if [[ "$force" == true ]] || gum confirm --default=No "Overwrite?"; then
      rm -f "$local_archive"
    else
      info "Download cancelled."
      exit 0
    fi
  fi

  info "Downloading from S3: s3://${S3_BUCKET}/${backup_ref}"
  s3_download "$backup_ref" "$local_archive" >&2
  info "Downloaded to $local_archive"

  # Print the local path to stdout so callers can capture it.
  # All other output (gum, s3cmd) goes to stderr.
  echo "$local_archive"
}

command_restore() {
  ensure_working_dir

  local force=false
  local local_only=false
  local pick=false
  local backup_ref=""
  local extracted_tmp=""

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f | --force)
        force=true
        shift
        ;;
      --local)
        local_only=true
        shift
        ;;
      --pick)
        pick=true
        shift
        ;;
      *)
        backup_ref="$1"
        shift
        ;;
    esac
  done

  if [[ "$pick" == true ]]; then
    if [[ "$local_only" == true ]]; then
      fail "--pick and --local cannot be used together"
    fi
    if [[ -n "$backup_ref" ]]; then
      fail "--pick does not accept a backup reference argument"
    fi
  fi

  local backup_dir=""
  local restore_root=""
  local prompted=false

  load_config || true

  if [[ "$local_only" == true ]]; then
    # Local mode: backup_ref is a local .tar.gz or directory
    if [[ -z "$backup_ref" ]]; then
      fail_help "Missing required argument: <backup_ref>"
    fi

    if [[ "$backup_ref" == *.tar.gz ]]; then
      if [[ ! -f "$backup_ref" ]]; then
        fail "Backup archive not found: $backup_ref"
      fi
      extracted_tmp="$(mktemp -d "${working_dir}/restore-XXXXXX")"
      info "Extracting $backup_ref..."
      tar -xzf "$backup_ref" -C "$extracted_tmp"
      backup_dir="$(find "$extracted_tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
      if [[ -z "$backup_dir" ]]; then
        rm -rf "$extracted_tmp"
        fail "Archive does not contain a backup directory"
      fi
    elif [[ -d "$backup_ref" ]]; then
      if [[ -f "${backup_ref}/Parbackupfile" ]]; then
        backup_dir="$backup_ref"
        # An unpacked restic restore keeps the staging tree below its absolute path
        local staging_marker="${restic_staging_root}/"
        if [[ "$backup_ref" == *"${staging_marker}"* ]]; then
          restore_root="${backup_ref%%${staging_marker}*}"
        fi
      else
        local found_backupfile
        found_backupfile="$(find "$backup_ref" -maxdepth 8 -name Parbackupfile -print -quit 2> /dev/null)"
        if [[ -z "$found_backupfile" ]]; then
          fail "Backup path not found: $backup_ref (expected a directory or .tar.gz file)"
        fi
        backup_dir="$(dirname "$found_backupfile")"
        restore_root="$backup_ref"
      fi
    else
      fail "Backup path not found: $backup_ref (expected a directory or .tar.gz file)"
    fi
  elif [[ "$(backend)" == restic ]]; then
    require_config
    require_restic_config

    if [[ "$pick" == true ]]; then
      local choices
      choices="$(restic_all_snapshot_rows | format_snapshot_refs)"
      if [[ -z "$choices" ]]; then
        fail "No backups found."
      fi

      backup_ref="$(echo "$choices" | gum filter)"
      backup_ref="${backup_ref##*$'\t'}"

      if [[ -z "$backup_ref" ]]; then
        info "No backup selected."
        exit 0
      fi
    fi

    if [[ -z "$backup_ref" ]]; then
      fail_help "Missing required argument: <backup_ref>"
    fi

    parse_snapshot_ref "$backup_ref"

    local repository
    repository="$(restic_repository_for "$RESTORE_REPO_NAME")"
    if ! restic_repo_exists "$repository"; then
      fail "No restic repository at $repository"
    fi

    if [[ "$force" != true ]]; then
      warn "You are about to restore deployment '$RESTORE_REPO_NAME' from: $repository ($RESTORE_SNAPSHOT)"
      warn "This will DROP and recreate all databases listed in the backup."

      if ! gum confirm --default=No "Proceed with restore?"; then
        info "Restore cancelled."
        exit 0
      fi
    fi
    prompted=true

    extracted_tmp="$(mktemp -d "${working_dir}/restore-XXXXXX")"
    backup_dir="$(restic_restore_snapshot "$repository" "$RESTORE_SNAPSHOT" "$extracted_tmp" "$RESTORE_REPO_NAME")"
    restore_root="$extracted_tmp"
  else
    # S3 mode: delegate download to command_download
    local download_args=()
    if [[ "$force" == true ]]; then
      download_args+=("--force")
    fi
    if [[ "$pick" == true ]]; then
      download_args+=("--pick")
    fi
    if [[ -n "$backup_ref" ]]; then
      download_args+=("$backup_ref")
    fi

    local local_archive
    local_archive="$(command_download "${download_args[@]}")"
    # command_download runs in a subshell, so its "exit 0" on cancel only ends the subshell.
    if [[ -z "$local_archive" ]]; then
      exit 0
    fi

    if [[ -d "$local_archive" ]]; then
      # The restic backend downloads a restored tree, not an archive
      local found_backupfile
      found_backupfile="$(find "$local_archive" -maxdepth 8 -name Parbackupfile -print -quit 2> /dev/null)"
      if [[ -z "$found_backupfile" ]]; then
        fail "Downloaded data does not contain a Parbackupfile: $local_archive"
      fi
      backup_dir="$(dirname "$found_backupfile")"
      restore_root="$local_archive"
      extracted_tmp="$local_archive"
    else
      extracted_tmp="$(mktemp -d "${working_dir}/restore-XXXXXX")"
      info "Extracting $local_archive..."
      tar -xzf "$local_archive" -C "$extracted_tmp"
      backup_dir="$(find "$extracted_tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
      if [[ -z "$backup_dir" ]]; then
        rm -rf "$extracted_tmp"
        fail "Archive does not contain a backup directory"
      fi

      # Clean up downloaded archive
      rm -f "$local_archive"
    fi
  fi

  require_parbackupfile "${backup_dir}/Parbackupfile"

  if [[ -n "$restore_root" && -n "${RESTORE_REPO_NAME:-}" && "$BACKUP_NAME" != "$RESTORE_REPO_NAME" ]]; then
    warn "Snapshot belongs to '$BACKUP_NAME', repository is named '$RESTORE_REPO_NAME'"
  fi

  if [[ "$force" != true && "$prompted" != true ]]; then
    warn "You are about to restore deployment '$BACKUP_NAME' from: $backup_dir"
    warn "This will DROP and recreate all databases listed in the backup."

    if ! gum confirm --default=No "Proceed with restore?"; then
      info "Restore cancelled."
      exit 0
    fi
  fi

  info "Restoring backup: $backup_dir (deployment: $BACKUP_NAME)"

  # Iterate over services
  IFS=',' read -ra svc_list <<< "$SERVICES"

  for svc_name in "${svc_list[@]}"; do
    # Trim whitespace
    svc_name="$(echo "$svc_name" | xargs)"

    local svc_type
    svc_type="$(require_svc_var "$svc_name" "TYPE")"

    info "Restoring service '$svc_name' (type: $svc_type)..."

    local svc_source_dir="${backup_dir}/${svc_name}"
    local volume_from_dir=false

    # Volumes and directories are stored at their host path inside the snapshot
    if [[ -n "$restore_root" && ("$svc_type" == "volume" || "$svc_type" == "dir") ]]; then
      local host_path
      host_path="$(manifest_host_path "$backup_dir" "$svc_name" || true)"
      if [[ -n "$host_path" ]]; then
        svc_source_dir="${restore_root}${host_path}"
        [[ "$svc_type" == "volume" ]] && volume_from_dir=true
      fi
    fi

    if [[ ! -d "$svc_source_dir" ]]; then
      fail "Service directory not found in backup: $svc_source_dir"
    fi

    case "$svc_type" in
      postgres)
        restore_postgres "$svc_name" "$svc_source_dir"
        ;;
      mongo)
        restore_mongo "$svc_name" "$svc_source_dir"
        ;;
      mysql)
        restore_mysql "$svc_name" "$svc_source_dir"
        ;;
      volume)
        if [[ "$volume_from_dir" == true ]]; then
          restore_volume_from_dir "$svc_name" "$svc_source_dir"
        elif [[ -f "${svc_source_dir}/volume.tar" ]]; then
          restore_volume "$svc_name" "$svc_source_dir"
        elif [[ -n "$restore_root" ]]; then
          fail "No volume data for '$svc_name' in the snapshot (no manifest entry, no volume.tar)"
        else
          # Archives before v1.7.0 hold plain files without owner information
          restore_volume "$svc_name" "$svc_source_dir"
        fi
        ;;
      dir)
        restore_dir "$svc_name" "$svc_source_dir"
        ;;
      *)
        fail "Unknown service type '$svc_type' for service '$svc_name'"
        ;;
    esac
  done

  # Clean up extracted temp dir if we extracted a tar.gz
  if [[ -n "$extracted_tmp" ]]; then
    rm -rf "$extracted_tmp"
  fi

  info "Restore complete from: $backup_ref"
}

# ---

# Make sure `gum` is installed.
if ! command -v gum > /dev/null; then
  echo "WARN: Required command 'gum' not available... Installing it."
  install_gum
fi

# Parse sub-command
subcommand="${1:-}"

# Check if first argument is a help flag
if [[ "$subcommand" == "-h" || "$subcommand" == "--help" || "$subcommand" == "" ]]; then
  print_help
  exit 0
fi

# Skip the subcommand argument
shift

# Handle sub-commands
case "$subcommand" in
  create) command_create "$@" ;;
  download) command_download "$@" ;;
  ls) command_ls "$@" ;;
  cleanup) command_cleanup "$@" ;;
  restic) command_restic "$@" ;;
  cron) command_cron "$@" ;;
  restore) command_restore "$@" ;;
  config) command_config "$@" ;;

  help)
    print_help
    exit 0
    ;;

  *) fail_help "Unknown command '$subcommand'" ;;
esac
