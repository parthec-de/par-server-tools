#!/usr/bin/env bash

set -euo pipefail

install_pkg() {
  sudo apt-get update && sudo apt-get install -y "$1"
}

install_gum() {
  sudo mkdir -p /etc/apt/keyrings
  test -f /etc/apt/keyrings/charm.gpg \
    || curl -fsSL https://repo.charm.sh/apt/gpg.key \
      | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
  test -f /etc/apt/sources.list.d/charm.list \
    || echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
      | sudo tee /etc/apt/sources.list.d/charm.list
  install_pkg "gum"
}

script_name="paralert"
script_version="1.2.0"
config_dir="${HOME}/.config/par"
config_file="${config_dir}/paralert.conf"

info() {
  gum log -l info -- "$1"
}

warn() {
  gum log -l warn -- "$1"
}

error() {
  gum log -l error -- "$1"
}

fail() {
  error "$1"
  exit 1
}

fail_help() {
  error "$1"
  echo ""
  print_help
  exit 1
}

print_help() {
  cat << EOF
$script_name v$script_version -- alert notifications for par server tools

Usage:
  $script_name <command> [options]

Commands:
  send        Send an alert notification email
  check-disk  Check disk usage and alert if a threshold is exceeded
  run         Run a command and alert if it exits non-zero
  cron        Configure an alert cron job (see \`check-disk\` and \`run\`)
  config      Show or set configuration (SMTP)
  help        Show this help message

Command-specific options:
  send:
    --subject <text>   Email subject
    --body <text>      Email body ('-' or omitted = read from stdin)

  check-disk:
    --threshold <pct>  Alert when usage is at or above this percent (default: 90)
    --path <path>      Filesystem to check (default: /)

  run:
    --subject <text>   Alert subject used when the command fails
    -- <command>       Command to run; an alert is sent if it exits non-zero

  cron:
    (no args)          Interactively add a cron job (Disk Usage or Custom)
    show               List paralert cron entries
    remove             Interactively remove a paralert cron entry

  config:
    set                Interactively configure SMTP notifications

Examples:
  $script_name config set
  $script_name send --subject "Backup FAILED" --body "See log."
  $script_name check-disk --threshold 90
  $script_name run --subject "Cert renew failed" -- certbot renew
  $script_name cron

Configuration is stored in $config_file.
EOF
}

mask_secret() {
  local value="$1"
  if [[ ${#value} -le 4 ]]; then
    echo "****"
  else
    echo "${value:0:4}****"
  fi
}

_sq() {
  # Escape a value for safe use inside single quotes: replace ' with '\''
  printf '%s' "${1//\'/\'\\\'\'}"
}

load_config() {
  if [[ ! -f "$config_file" ]]; then
    return 1
  fi
  # shellcheck source=/dev/null
  source "$config_file"
}

save_config() {
  mkdir -p "$config_dir"
  cat > "$config_file" << EOF
# paralert configuration
ALERT_SMTP_HOST='$(_sq "${ALERT_SMTP_HOST:-}")'
ALERT_SMTP_PORT='$(_sq "${ALERT_SMTP_PORT:-587}")'
ALERT_SMTP_USER='$(_sq "${ALERT_SMTP_USER:-}")'
ALERT_SMTP_PASSWORD='$(_sq "${ALERT_SMTP_PASSWORD:-}")'
ALERT_SMTP_FROM='$(_sq "${ALERT_SMTP_FROM:-}")'
ALERT_RECIPIENTS='$(_sq "${ALERT_RECIPIENTS:-}")'
ALERT_SMTP_INSECURE='$(_sq "${ALERT_SMTP_INSECURE:-}")'
EOF
  chmod 600 "$config_file"
  info "Config saved to $config_file"
}

# Send a notification email via SMTP using curl.
# Requires ALERT_SMTP_HOST, ALERT_SMTP_PORT, ALERT_SMTP_FROM, and ALERT_RECIPIENTS to be set.
# ALERT_SMTP_USER / ALERT_SMTP_PASSWORD are optional (skipped if empty = no auth).
_send_email() {
  local subject="$1"
  local body="$2"

  # Silently skip if alert SMTP is not configured
  if [[ -z "${ALERT_SMTP_HOST:-}" || -z "${ALERT_SMTP_FROM:-}" || -z "${ALERT_RECIPIENTS:-}" ]]; then
    return 0
  fi

  local smtp_port="${ALERT_SMTP_PORT:-587}"

  # TLS is mandatory: implicit TLS on port 465, STARTTLS on any other port.
  # ALERT_SMTP_INSECURE='true' disables it for local test servers only.
  local smtp_scheme="smtp"
  local -a tls_args=()
  if [[ "${ALERT_SMTP_INSECURE:-}" != "true" ]]; then
    if [[ "$smtp_port" == "465" ]]; then
      smtp_scheme="smtps"
    else
      tls_args+=(--ssl-reqd)
    fi
  fi
  local smtp_url="${smtp_scheme}://${ALERT_SMTP_HOST}:${smtp_port}"

  # Build recipient list for curl (one --mail-rcpt per address)
  local -a rcpt_args=()
  local to_header=""
  IFS=',' read -ra recipients <<< "$ALERT_RECIPIENTS"
  for rcpt in "${recipients[@]}"; do
    rcpt="$(echo "$rcpt" | xargs)"
    rcpt_args+=(--mail-rcpt "$rcpt")
    if [[ -n "$to_header" ]]; then
      to_header+=", $rcpt"
    else
      to_header="$rcpt"
    fi
  done

  # Build auth args (skip if no user configured)
  local -a auth_args=()
  if [[ -n "${ALERT_SMTP_USER:-}" ]]; then
    auth_args+=(--user "${ALERT_SMTP_USER}:${ALERT_SMTP_PASSWORD:-}")
  fi

  local hostname
  hostname="$(hostname 2> /dev/null || cat /etc/hostname 2> /dev/null || echo "unknown")"

  # Compose email with CRLF line endings throughout (RFC 2822 requires \r\n)
  # First build the body with LF, then convert all LF to CRLF at the end.
  local raw
  raw="$(printf 'From: %s\nTo: %s\nSubject: %s\nContent-Type: text/plain; charset=UTF-8\n\n%s\n\n--\nHost: %s\nDate: %s\n' \
    "$ALERT_SMTP_FROM" "$to_header" "$subject" "$body" "$hostname" "$(date '+%Y-%m-%d %H:%M:%S %Z')")"
  local message
  message="$(printf '%s' "$raw" | sed 's/$/\r/')"

  if ! curl --silent --show-error \
    --url "$smtp_url" \
    "${tls_args[@]}" \
    --mail-from "$ALERT_SMTP_FROM" \
    "${rcpt_args[@]}" \
    "${auth_args[@]}" \
    -T - <<< "$message" 2>&1; then
    error "Failed to send notification email"
    return 1
  fi
}

# Load config (if any) and send an alert email. Silently no-ops when SMTP is
# not configured (see _send_email).
_alert() {
  load_config || true
  _send_email "$1" "$2"
}

command_send() {
  local subject=""
  local body=""
  local body_set=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subject)
        subject="$2"
        shift 2
        ;;
      --body)
        body="$2"
        body_set=true
        shift 2
        ;;
      -h | --help)
        print_help
        exit 0
        ;;
      *)
        fail_help "Unknown option '$1' for send command"
        ;;
    esac
  done

  # Read body from stdin when not passed explicitly (or when passed as '-')
  if [[ "$body_set" != true || "$body" == "-" ]]; then
    body="$(cat)"
  fi

  _alert "$subject" "$body"
}

command_check_disk() {
  local threshold=90
  local path="/"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --threshold)
        threshold="$2"
        shift 2
        ;;
      --path)
        path="$2"
        shift 2
        ;;
      -h | --help)
        print_help
        exit 0
        ;;
      *)
        fail_help "Unknown option '$1' for check-disk command"
        ;;
    esac
  done

  local usage
  usage="$(df -P "$path" 2> /dev/null | awk 'NR==2 { gsub(/%/, "", $5); print $5 }')"
  if [[ -z "$usage" ]]; then
    fail "Could not determine disk usage for '$path'."
  fi

  if [[ "$usage" -ge "$threshold" ]]; then
    local host
    host="$(hostname 2> /dev/null || echo unknown)"
    _alert "[paralert] Disk usage ${usage}% on ${host} (${path})" "$(df -h "$path")"
  fi
}

command_run() {
  local subject="Scheduled command failed"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subject)
        subject="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -h | --help)
        print_help
        exit 0
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    fail "No command given. Usage: $script_name run --subject <text> -- <command> [args...]"
  fi

  local out rc
  set +e
  out="$("$@" 2>&1)"
  rc=$?
  set -e

  if [[ $rc -ne 0 ]]; then
    _alert "[paralert] ${subject} (exit ${rc})" "$out"
  fi
}

config_set() {
  info "Configuring alert notifications..."

  ALERT_SMTP_HOST="$(gum input --placeholder "smtp.example.com" \
    --header "SMTP Host" --value "${ALERT_SMTP_HOST:-}")"
  ALERT_SMTP_PORT="$(gum input --placeholder "587" \
    --header "SMTP Port" --value "${ALERT_SMTP_PORT:-587}")"
  ALERT_SMTP_USER="$(gum input --placeholder "user@example.com (leave empty for no auth)" \
    --header "SMTP User" --value "${ALERT_SMTP_USER:-}")"
  ALERT_SMTP_PASSWORD="$(gum input --placeholder "password" --password \
    --header "SMTP Password" --value "${ALERT_SMTP_PASSWORD:-}")"
  ALERT_SMTP_FROM="$(gum input --placeholder "backups@example.com" \
    --header "From address" --value "${ALERT_SMTP_FROM:-}")"
  ALERT_RECIPIENTS="$(gum input --placeholder "admin@example.com,ops@example.com" \
    --header "Error recipients (comma-separated)" --value "${ALERT_RECIPIENTS:-}")"

  save_config
}

command_config() {
  local subcmd="${1:-}"

  # Load existing config to preserve values when saving
  load_config || true

  case "$subcmd" in
    set)
      config_set
      ;;

    "")
      if [[ ! -f "$config_file" ]]; then
        warn "No config found at $config_file"
        info "Run '$script_name config set' to configure."
        return 0
      fi
      echo "Config: $config_file"
      echo ""
      echo "ALERT_SMTP_HOST     = ${ALERT_SMTP_HOST:-<not set>}"
      echo "ALERT_SMTP_PORT     = ${ALERT_SMTP_PORT:-<not set>}"
      echo "ALERT_SMTP_USER     = ${ALERT_SMTP_USER:-<not set>}"
      echo "ALERT_SMTP_PASSWORD = $(mask_secret "${ALERT_SMTP_PASSWORD:-}")"
      echo "ALERT_SMTP_FROM     = ${ALERT_SMTP_FROM:-<not set>}"
      echo "ALERT_RECIPIENTS    = ${ALERT_RECIPIENTS:-<not set>}"
      if [[ "${ALERT_SMTP_INSECURE:-}" == "true" ]]; then
        echo "ALERT_SMTP_INSECURE = true (TLS disabled, test servers only)"
      fi
      ;;

    *)
      fail_help "Unknown config subcommand '$subcmd'. Use 'config' or 'config set'."
      ;;
  esac
}

_choose_schedule() {
  local choice
  choice="$(gum choose \
    "Every 15 minutes" \
    "Every hour" \
    "All six hours" \
    "Daily at 08:00" \
    "Daily at midnight" \
    "Custom")"

  case "$choice" in
    "Every 15 minutes") echo "*/15 * * * *" ;;
    "Every hour") echo "0 * * * *" ;;
    "All six hours") echo "0 */6 * * *" ;;
    "Daily at 08:00") echo "0 8 * * *" ;;
    "Daily at midnight") echo "0 0 * * *" ;;
    "Custom")
      local s
      s="$(gum input --placeholder "0 8 * * *" --header "Enter cron schedule (5 fields)")"
      [[ -n "$s" ]] || fail "No schedule provided."
      echo "$s"
      ;;
    *)
      fail "No schedule selected."
      ;;
  esac
}

# Add or replace a crontab line identified by its trailing marker.
_install_cron_line() {
  local marker="$1"
  local cron_line="$2"

  local current new
  current="$(crontab -l 2> /dev/null || true)"

  if echo "$current" | grep -q "${marker}$"; then
    new="$(echo "$current" | grep -v "${marker}$" || true)"
    info "Updating existing cron entry ($marker)."
  else
    new="$current"
  fi

  if [[ -n "$new" ]]; then
    new="${new}
${cron_line}"
  else
    new="$cron_line"
  fi

  echo "$new" | crontab -
  info "Cron entry installed: ${cron_line}"
}

_cron_add() {
  local self="$1"
  local kind
  kind="$(gum choose "Disk Usage" "Custom")"

  case "$kind" in
    "Disk Usage")
      local schedule threshold path
      schedule="$(_choose_schedule)"
      threshold="$(gum input --value "90" --header "Alert when disk usage % is at or above")"
      [[ -n "$threshold" ]] || fail "No threshold provided."
      path="$(gum input --value "/" --header "Filesystem path to check")"
      [[ -n "$path" ]] || path="/"
      _install_cron_line "# paralert:disk" \
        "${schedule} ${self} check-disk --threshold ${threshold} --path ${path} # paralert:disk"
      ;;
    "Custom")
      local schedule subject command slug
      schedule="$(_choose_schedule)"
      subject="$(gum input --header "Alert subject" --placeholder "My check failed")"
      [[ -n "$subject" ]] || fail "No subject provided."
      command="$(gum input --header "Command to run (alert is sent if it exits non-zero)" \
        --placeholder "/usr/local/bin/mycheck --flag")"
      [[ -n "$command" ]] || fail "No command provided."
      slug="$(echo "$subject" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//;s/-$//')"
      [[ -n "$slug" ]] || slug="custom"
      _install_cron_line "# paralert:custom-${slug}" \
        "${schedule} ${self} run --subject \"${subject}\" -- ${command} # paralert:custom-${slug}"
      ;;
    *)
      fail "No type selected."
      ;;
  esac
}

_cron_remove() {
  local current entries
  current="$(crontab -l 2> /dev/null || true)"
  entries="$(echo "$current" | grep "# paralert:" || true)"

  if [[ -z "$entries" ]]; then
    info "No paralert cron entries found."
    return 0
  fi

  local choice
  choice="$(echo "$entries" | gum choose)"
  [[ -n "$choice" ]] || {
    info "Nothing selected."
    return 0
  }

  local new
  new="$(echo "$current" | grep -vF "$choice" || true)"
  if [[ -n "$new" ]]; then
    echo "$new" | crontab -
  else
    crontab -r 2> /dev/null || true
  fi
  info "Removed cron entry."
}

command_cron() {
  local subcmd="${1:-}"
  local self
  self="$(readlink -f "$0")"

  case "$subcmd" in
    show)
      local entries
      entries="$(crontab -l 2> /dev/null | grep "# paralert:" || true)"
      if [[ -z "$entries" ]]; then
        info "No paralert cron entries found."
      else
        echo "$entries"
      fi
      ;;
    remove)
      _cron_remove
      ;;
    "")
      _cron_add "$self"
      ;;
    *)
      fail_help "Unknown cron subcommand '$subcmd'. Use 'cron', 'cron show', or 'cron remove'."
      ;;
  esac
}

main() {
  local command="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    send)
      command_send "$@"
      ;;
    check-disk)
      command_check_disk "$@"
      ;;
    run)
      command_run "$@"
      ;;
    cron)
      command_cron "$@"
      ;;
    config)
      command_config "$@"
      ;;
    help | -h | --help)
      print_help
      ;;
    *)
      fail_help "Unknown command '$command'."
      ;;
  esac
}

# Make sure `gum` is installed.
if ! command -v gum > /dev/null; then
  echo "WARN: Required command 'gum' not available... Installing it."
  install_gum
fi

main "$@"
